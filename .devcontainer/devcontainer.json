{
  "name": "TalkScout",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-mssql.mssql",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "Prisma.prisma",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-azuretools.vscode-docker",
        "Fission-AI.openspec"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[markdown]": { "editor.defaultFormatter": null },
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [3000, 1433],
  "portsAttributes": {
    "3000": { "label": "TalkScout (Next.js)", "onAutoForward": "openBrowser" },
    "1433": { "label": "SQL Server 2025",     "onAutoForward": "silent" }
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "remoteEnv": {
    "DATABASE_URL": "sqlserver://host.docker.internal:1433;database=talkscout;user=sa;password=TalkScout!Demo2026;trustServerCertificate=true;encrypt=true",
    "OLLAMA_HOST": "http://host.docker.internal:11434",
    "EMBEDDING_MODEL": "nomic-embed-text",
    "EMBEDDING_DIM": "768"
  },
  "postCreateCommand": "npm install && npx prisma generate",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
