# Copy to .env and keep out of git.

# SQL Server 2025 in docker-compose.
DATABASE_URL="sqlserver://localhost:1433;database=talkscout;user=sa;password=TalkScout!Demo2026;trustServerCertificate=true;encrypt=true"

# Host Ollama (run `ollama serve` on the host; faster than container on Apple Silicon).
OLLAMA_HOST="http://localhost:11434"

# Embedding model. Must be pulled once: `ollama pull nomic-embed-text`.
EMBEDDING_MODEL="nomic-embed-text"
EMBEDDING_DIM=768
